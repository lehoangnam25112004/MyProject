@model ConstructionProjectManagement.ViewModels.EquipmentAssignmentViewModel
@using ConstructionProjectManagement.Models
@{
    ViewData["Title"] = "Bàn giao thiết bị";
    var equipment = (IReadOnlyCollection<Equipment>)ViewBag.Equipment;
    var projects = (IReadOnlyCollection<Project>)ViewBag.Projects;
    var tasks = (IReadOnlyCollection<ConstructionProjectManagement.Models.Task>)ViewBag.Tasks;
    var users = (IReadOnlyCollection<ApplicationUser>)ViewBag.Users;
}
<h1 class="h3 mb-3">Bàn giao thiết bị</h1>
<form asp-action="Assign" method="post" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Thiết bị</label><select asp-for="EquipmentId" class="form-select"><option value="">-- Chọn --</option>@foreach (var item in equipment) { <option value="@item.Id">@item.EquipmentCode - @item.Name</option> }</select></div>
        <div class="col-md-6"><label class="form-label">Dự án</label><select asp-for="ProjectId" class="form-select"><option value="">-- Chọn --</option>@foreach (var item in projects) { <option value="@item.Id">@item.ProjectCode - @item.Name</option> }</select></div>
        <div class="col-md-6"><label class="form-label">Công việc</label><select asp-for="TaskId" class="form-select"><option value="">-- Không chọn --</option>@foreach (var item in tasks) { <option value="@item.Id">@item.Title</option> }</select></div>
        <div class="col-md-6"><label class="form-label">Người nhận</label><select asp-for="AssignedToId" class="form-select"><option value="">-- Chọn --</option>@foreach (var item in users) { <option value="@item.Id">@item.FullName</option> }</select></div>
        <div class="col-12"><label asp-for="Notes" class="form-label">Ghi chú</label><textarea asp-for="Notes" class="form-control"></textarea></div>
    </div>
    <button class="btn btn-primary mt-3" type="submit">Bàn giao</button>
</form>
