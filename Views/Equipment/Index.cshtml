@model ConstructionProjectManagement.ViewModels.EquipmentIndexViewModel
@using ConstructionProjectManagement.Models
@{ ViewData["Title"] = "Quản lý thiết bị"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3">Quản lý thiết bị</h1><div><a asp-action="Assign" class="btn btn-outline-primary">Bàn giao</a> <a asp-action="Create" class="btn btn-primary">Thêm thiết bị</a></div></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="card mb-4"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Mã</th><th>Tên</th><th>Nhóm</th><th>Tình trạng</th><th></th></tr></thead><tbody>
@foreach (var item in Model.Equipment) { <tr><td>@item.EquipmentCode</td><td>@item.Name</td><td>@item.Category</td><td>@item.Status</td><td><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>@if (item.Status == EquipmentStatus.Available) { <form asp-action="SetMaintenance" method="post" class="d-inline ms-2"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-warning">Bảo trì</button></form> }</td></tr> }
</tbody></table></div></div>
<h2 class="h5">Thiết bị đang sử dụng</h2>
<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Thiết bị</th><th>Dự án</th><th>Người nhận</th><th>Bàn giao lúc</th><th></th></tr></thead><tbody>
@foreach (var item in Model.Assignments) { <tr><td>@item.Equipment.EquipmentCode - @item.Equipment.Name</td><td>@item.Project.ProjectCode</td><td>@item.AssignedTo.FullName</td><td>@item.HandedOverAt.ToLocalTime()</td><td><form asp-action="Return" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-primary">Thu hồi</button></form></td></tr> }
</tbody></table></div>
