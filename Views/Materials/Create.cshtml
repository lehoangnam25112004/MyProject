@model ConstructionProjectManagement.ViewModels.MaterialEditViewModel
@{
    ViewData["Title"] = "Thêm vật tư";
}
<h1 class="h3 mb-3">Thêm vật tư</h1>
<form asp-action="Create" method="post" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary" type="submit">Lưu</button>
</form>
