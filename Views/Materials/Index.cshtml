@model ConstructionProjectManagement.ViewModels.MaterialIndexViewModel
@using ConstructionProjectManagement.Models
@{
    ViewData["Title"] = "Quản lý vật tư";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Quản lý vật tư</h1>
    <div><a class="btn btn-outline-primary" asp-action="CreateRequest">Tạo yêu cầu</a> <a class="btn btn-primary" asp-action="Create">Thêm vật tư</a></div>
</div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="card mb-4"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Mã</th><th>Tên</th><th>Đơn vị</th><th>Tồn kho</th><th></th></tr></thead><tbody>
@foreach (var material in Model.Materials) { <tr><td>@material.MaterialCode</td><td>@material.Name</td><td>@material.Unit</td><td>@material.CurrentStock</td><td><a asp-action="Edit" asp-route-id="@material.Id">Sửa</a></td></tr> }
</tbody></table></div></div>
<h2 class="h5">Phiếu yêu cầu gần đây</h2>
<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Dự án</th><th>Người tạo</th><th>Vật tư</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var request in Model.Requests) { <tr><td>@request.Project.ProjectCode</td><td>@request.RequestedBy.FullName</td><td>@string.Join(", ", request.Items.Select(item => $"{item.Material.Name}: {item.QuantityRequested}"))</td><td>@request.Status</td><td>
@if (request.Status == MaterialRequestStatus.Pending) { <form asp-action="Approve" method="post" class="d-inline"><input type="hidden" name="id" value="@request.Id" /><button class="btn btn-sm btn-success">Duyệt</button></form><form asp-action="Reject" method="post" class="d-inline"><input type="hidden" name="id" value="@request.Id" /><button class="btn btn-sm btn-outline-danger">Từ chối</button></form> }
@if (request.Status == MaterialRequestStatus.Approved) { <form asp-action="Issue" method="post"><input type="hidden" name="id" value="@request.Id" /><button class="btn btn-sm btn-primary">Xuất vật tư</button></form> }
</td></tr> }
</tbody></table></div>
