@model ConstructionProjectManagement.ViewModels.AccountListViewModel
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Quản lý tài khoản</h1>
    <a class="btn btn-primary" asp-action="Create">Tạo tài khoản</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Tên đăng nhập</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var account in Model.Accounts)
            {
                <tr>
                    <td>@account.FullName</td>
                    <td>@account.UserName</td>
                    <td>@string.Join(", ", account.Roles)</td>
                    <td>
                        <span class="badge @(account.IsActive ? "text-bg-success" : "text-bg-secondary")">
                            @(account.IsActive ? "Đang hoạt động" : "Đã khóa")
                        </span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@account.Id">Sửa</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
