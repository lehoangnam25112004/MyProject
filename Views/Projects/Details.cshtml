@model ConstructionProjectManagement.Models.Project
@using ConstructionProjectManagement.Models
@{
    ViewData["Title"] = "Chi tiết dự án";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">@Model.Name</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("Project Director"))
    {
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Cập nhật</a>
    }
    <a class="btn btn-outline-secondary" asp-controller="Wbs" asp-action="Index" asp-route-projectId="@Model.Id">Xem WBS</a>
    @if (User.IsInRole("Admin") || User.IsInRole("Project Director") || User.IsInRole("Project Manager"))
    {
        <a class="btn btn-outline-secondary" asp-controller="ProjectMembers" asp-action="Index" asp-route-projectId="@Model.Id">Thành viên</a>
    }
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Mã dự án</dt>
            <dd class="col-sm-9">@Model.ProjectCode</dd>
            <dt class="col-sm-3">Địa điểm</dt>
            <dd class="col-sm-9">@Model.Location</dd>
            <dt class="col-sm-3">Chủ đầu tư</dt>
            <dd class="col-sm-9">@Model.ClientName</dd>
            <dt class="col-sm-3">Project Manager</dt>
            <dd class="col-sm-9">@Model.ProjectManager?.FullName</dd>
            <dt class="col-sm-3">Thời gian</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("dd/MM/yyyy") - @Model.ExpectedEndDate.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Ngân sách</dt>
            <dd class="col-sm-9">@Model.Budget.ToString("N0")</dd>
            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
</div>

<h2 class="h5">Thành viên dự án</h2>
<div class="card">
    <ul class="list-group list-group-flush">
    @foreach (var member in Model.Members)
    {
        <li class="list-group-item d-flex justify-content-between">
            <span>@member.User.FullName (@member.User.UserName)</span>
            <span>@member.AssignmentRole</span>
        </li>
    }
    </ul>
</div>
