@model ConstructionProjectManagement.ViewModels.EmployeeListViewModel
@{
    ViewData["Title"] = "Nhân sự";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Nhân sự</h1>
    <a class="btn btn-primary" asp-action="Create">Tạo hồ sơ nhân viên</a>
</div>
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Mã</th><th>Họ tên</th><th>Bộ phận</th><th>Chức vụ</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var employee in Model.Employees)
            {
                <tr>
                    <td>@employee.EmployeeCode</td>
                    <td>@employee.User.FullName</td>
                    <td>@employee.Department?.Name</td>
                    <td>@employee.Position</td>
                    <td>@(employee.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")</td>
                    <td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@employee.Id">Sửa</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
