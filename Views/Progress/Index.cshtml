@model ConstructionProjectManagement.ViewModels.ProgressIndexViewModel
@using ConstructionProjectManagement.Models
@using TaskStatusModel = ConstructionProjectManagement.Models.TaskStatus
@{
    ViewData["Title"] = "Theo dõi tiến độ";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Theo dõi tiến độ</h1>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <canvas id="progressChart" height="100"></canvas>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Công việc</th>
                    <th>Dự án</th>
                    <th>Kế hoạch</th>
                    <th>Thực tế</th>
                    <th>Trạng thái</th>
                    <th>Cập nhật</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var task in Model.Tasks)
            {
                var overdue = task.PlannedEndDate.Date < DateTime.UtcNow.Date &&
                              task.PercentComplete < 100 &&
                              task.Status != TaskStatusModel.Completed;
                <tr class="@(overdue ? "table-warning" : string.Empty)">
                    <td>
                        @task.Title
                        @if (overdue)
                        {
                            <span class="badge text-bg-warning">Chậm</span>
                        }
                    </td>
                    <td>@task.Project.ProjectCode</td>
                    <td>@task.PlannedEndDate.ToString("dd/MM/yyyy")</td>
                    <td>@task.PercentComplete.ToString("0.##")%</td>
                    <td>@task.Status</td>
                    <td>
                        <form asp-action="Update" method="post" class="row g-1">
                            <input type="hidden" name="TaskId" value="@task.Id" />
                            <div class="col-4">
                                <input name="PercentComplete" type="number" min="0" max="100" step="0.01"
                                       value="@task.PercentComplete" class="form-control form-control-sm" />
                            </div>
                            <div class="col-4">
                                <select name="Status" class="form-select form-select-sm">
                                    @foreach (var status in Enum.GetValues<TaskStatusModel>())
                                    {
                                        <option value="@status" selected="@(task.Status == status)">@status</option>
                                    }
                                </select>
                            </div>
                            <div class="col-4">
                                <input name="DelayReason" placeholder="Nguyên nhân nếu chậm"
                                       class="form-control form-control-sm" />
                            </div>
                            <div class="col-12 mt-1">
                                <button type="submit" class="btn btn-sm btn-primary">Lưu tiến độ</button>
                            </div>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        fetch('@Url.Action("ChartData", "Progress")')
            .then(response => response.json())
            .then(data => {
                new Chart(document.getElementById('progressChart'), {
                    type: 'bar',
                    data: {
                        labels: data.map(item => item.label),
                        datasets: [
                            { label: 'Tiến độ trung bình (%)', data: data.map(item => item.planned) },
                            { label: 'Tỷ lệ hoàn thành (%)', data: data.map(item => item.actual) }
                        ]
                    },
                    options: { responsive: true, scales: { y: { beginAtZero: true, max: 100 } } }
                });
            });
    </script>
}
