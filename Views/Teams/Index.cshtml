@model IReadOnlyCollection<ConstructionProjectManagement.Models.ConstructionTeam>
@using ConstructionProjectManagement.Models
@{
    ViewData["Title"] = "Đội thi công";
    var employees = (IReadOnlyCollection<Employee>)ViewBag.Employees;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Đội thi công</h1>
    <a class="btn btn-primary" asp-action="Create">Tạo đội</a>
</div>
@foreach (var team in Model)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between">
            <strong>@team.Name</strong>
            <span>@team.Description</span>
        </div>
        <div class="card-body">
            <ul>
            @foreach (var member in team.Members)
            {
                <li>@member.Employee.EmployeeCode - @member.Employee.User.FullName</li>
            }
            </ul>
            <form asp-action="AddMember" method="post" class="row g-2">
                <input type="hidden" name="TeamId" value="@team.Id" />
                <div class="col-md-6">
                    <select name="EmployeeId" class="form-select">
                        <option value="">-- Thêm nhân viên --</option>
                        @foreach (var employee in employees)
                        {
                            <option value="@employee.Id">@employee.EmployeeCode - @employee.User.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3"><button class="btn btn-outline-primary" type="submit">Thêm</button></div>
            </form>
        </div>
    </div>
}
