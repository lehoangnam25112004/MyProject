@model ConstructionProjectManagement.ViewModels.TeamEditViewModel
@{
    ViewData["Title"] = "Tạo đội thi công";
}
<h1 class="h3 mb-3">Tạo đội thi công</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="card card-body">
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
        <button type="submit" class="btn btn-primary">Lưu</button>
    </div>
</form>
