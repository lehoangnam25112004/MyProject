@model ConstructionProjectManagement.ViewModels.TaskListViewModel
@using ConstructionProjectManagement.Models
@{
    ViewData["Title"] = "Quản lý công việc";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Quản lý công việc</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("Project Director") || User.IsInRole("Project Manager"))
    {
        <a class="btn btn-primary" asp-action="Create">Tạo công việc</a>
    }
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Công việc</th>
                    <th>Dự án</th>
                    <th>WBS</th>
                    <th>Ưu tiên</th>
                    <th>Hạn</th>
                    <th>Trạng thái</th>
                    <th>Hoàn thành</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var task in Model.Tasks)
            {
                <tr>
                    <td>@task.Title</td>
                    <td>@task.Project.ProjectCode</td>
                    <td>@task.WorkItem?.WbsCode</td>
                    <td>@task.Priority</td>
                    <td>@task.PlannedEndDate.ToString("dd/MM/yyyy")</td>
                    <td>@task.Status</td>
                    <td>@task.PercentComplete.ToString("0.##")%</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@task.Id">Chi tiết</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
