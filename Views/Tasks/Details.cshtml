@model ConstructionProjectManagement.ViewModels.TaskDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết công việc";
    var task = Model.Task;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">@task.Title</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("Project Director") || User.IsInRole("Project Manager"))
    {
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@task.Id">Cập nhật</a>
    }
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Dự án</dt>
            <dd class="col-sm-9">@task.Project.ProjectCode - @task.Project.Name</dd>
            <dt class="col-sm-3">WBS</dt>
            <dd class="col-sm-9">@task.WorkItem?.WbsCode - @task.WorkItem?.Name</dd>
            <dt class="col-sm-3">Mô tả</dt>
            <dd class="col-sm-9">@task.Description</dd>
            <dt class="col-sm-3">Ưu tiên / trạng thái</dt>
            <dd class="col-sm-9">@task.Priority / @task.Status</dd>
            <dt class="col-sm-3">Thời gian</dt>
            <dd class="col-sm-9">@task.PlannedStartDate.ToString("dd/MM/yyyy") - @task.PlannedEndDate.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Hoàn thành</dt>
            <dd class="col-sm-9">@task.PercentComplete.ToString("0.##")%</dd>
            <dt class="col-sm-3">Người phụ trách</dt>
            <dd class="col-sm-9">@string.Join(", ", task.Assignments.Select(assignment => assignment.User.FullName))</dd>
        </dl>
    </div>
</div>
