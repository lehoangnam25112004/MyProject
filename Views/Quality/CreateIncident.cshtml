@model ConstructionProjectManagement.ViewModels.IncidentCreateViewModel
@using ConstructionProjectManagement.Models
@{ ViewData["Title"] = "Tạo sự cố"; var projects = (IReadOnlyCollection<Project>)ViewBag.Projects; var tasks = (IReadOnlyCollection<ConstructionProjectManagement.Models.Task>)ViewBag.Tasks; var users = (IReadOnlyCollection<ApplicationUser>)ViewBag.Users; }
<h1 class="h3 mb-3">Tạo sự cố</h1>
<form asp-action="CreateIncident" method="post" class="card card-body">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
<div class="col-md-6"><label class="form-label">Dự án</label><select asp-for="ProjectId" class="form-select"><option value="">-- Chọn --</option>@foreach(var item in projects){<option value="@item.Id">@item.ProjectCode - @item.Name</option>}</select></div>
<div class="col-md-6"><label class="form-label">Công việc</label><select asp-for="TaskId" class="form-select"><option value="">-- Không chọn --</option>@foreach(var item in tasks){<option value="@item.Id">@item.Title</option>}</select></div>
<div class="col-md-6"><label asp-for="Title" class="form-label">Tiêu đề</label><input asp-for="Title" class="form-control" /></div>
<div class="col-md-3"><label asp-for="Priority" class="form-label">Mức độ</label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<IncidentPriority>()" class="form-select"></select></div>
<div class="col-md-3"><label asp-for="AssignedToId" class="form-label">Người xử lý</label><select asp-for="AssignedToId" class="form-select"><option value="">-- Chưa phân công --</option>@foreach(var item in users){<option value="@item.Id">@item.FullName</option>}</select></div>
<div class="col-12"><label asp-for="Description" class="form-label">Mô tả</label><textarea asp-for="Description" class="form-control"></textarea></div>
</div><button class="btn btn-primary mt-3">Lưu</button></form>
