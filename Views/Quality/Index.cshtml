@model ConstructionProjectManagement.ViewModels.QualityIndexViewModel
@using ConstructionProjectManagement.Models
@{ ViewData["Title"] = "Sự cố, RFI và nghiệm thu"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3">Sự cố, RFI và nghiệm thu</h1><div><a asp-action="CreateIncident" class="btn btn-outline-danger">Tạo sự cố</a> <a asp-action="CreateRfi" class="btn btn-outline-primary">Tạo RFI</a> <a asp-action="CreateInspection" class="btn btn-primary">Tạo nghiệm thu</a></div></div>
@if (TempData["SuccessMessage"] is string success){<div class="alert alert-success">@success</div>}@if (TempData["ErrorMessage"] is string error){<div class="alert alert-danger">@error</div>}
<h2 class="h5">Sự cố</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Tiêu đề</th><th>Dự án</th><th>Mức độ</th><th>Trạng thái</th><th>Người xử lý</th></tr></thead><tbody>@foreach(var item in Model.Incidents){<tr><td>@item.Title</td><td>@item.Project.ProjectCode</td><td>@item.Priority</td><td>@item.Status</td><td>@item.AssignedTo?.FullName</td></tr>}</tbody></table></div>
<h2 class="h5 mt-4">RFI</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Chủ đề</th><th>Dự án</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var item in Model.Rfis){<tr><td>@item.Subject</td><td>@item.Project.ProjectCode</td><td>@item.Status</td><td>@if(item.Status != RfiStatus.Closed){<a asp-action="RespondRfi" asp-route-id="@item.Id">Phản hồi</a>}</td></tr>}</tbody></table></div>
<h2 class="h5 mt-4">Nghiệm thu</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Công việc</th><th>Dự án</th><th>Kết quả</th><th>Ghi nhận</th></tr></thead><tbody>@foreach(var item in Model.Inspections){<tr><td>@item.Task.Title</td><td>@item.Project.ProjectCode</td><td>@item.Result</td><td>@if(item.Result == InspectionResult.Pending){<form asp-action="RecordInspection" method="post" class="row g-1"><input type="hidden" name="id" value="@item.Id" /><select name="Result" class="form-select form-select-sm"><option value="Passed">Đạt</option><option value="Failed">Không đạt</option></select><input name="Notes" class="form-control form-control-sm" placeholder="Kết quả" /><input name="CorrectiveAction" class="form-control form-control-sm" placeholder="Khắc phục nếu không đạt" /><button class="btn btn-sm btn-primary">Lưu</button></form>}</td></tr>}</tbody></table></div>
