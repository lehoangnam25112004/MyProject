@model ConstructionProjectManagement.ViewModels.ConstructionLogEditViewModel
@{ ViewData["Title"] = "Sửa nhật ký thi công"; }
<h1 class="h3 mb-3">Sửa nhật ký thi công</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary" type="submit">Lưu thay đổi</button>
</form>
