@model ConstructionProjectManagement.ViewModels.ProjectPhaseViewModel
@{
    ViewData["Title"] = "Thêm giai đoạn";
}

<h1 class="h3 mb-3">Thêm giai đoạn</h1>
<form asp-action="CreatePhase" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input asp-for="ProjectId" type="hidden" />
    <div class="card card-body">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SequenceOrder" class="form-label"></label>
            <input asp-for="SequenceOrder" class="form-control" />
            <span asp-validation-for="SequenceOrder" class="text-danger"></span>
        </div>
        <div>
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
