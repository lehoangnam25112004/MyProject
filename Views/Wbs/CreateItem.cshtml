@model ConstructionProjectManagement.ViewModels.WorkItemViewModel
@using ConstructionProjectManagement.Models
@{
    ViewData["Title"] = "Thêm hạng mục WBS";
    var phases = (IReadOnlyCollection<ProjectPhase>)ViewBag.Phases;
    var workItems = (IReadOnlyCollection<WorkItem>)ViewBag.WorkItems;
}

<h1 class="h3 mb-3">Thêm hạng mục WBS</h1>
<form asp-action="CreateItem" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input asp-for="ProjectId" type="hidden" />
    <div class="card card-body">
        <div class="mb-3">
            <label asp-for="ProjectPhaseId" class="form-label"></label>
            <select asp-for="ProjectPhaseId" class="form-select">
                <option value="">-- Chọn giai đoạn --</option>
                @foreach (var phase in phases)
                {
                    <option value="@phase.Id">@phase.SequenceOrder - @phase.Name</option>
                }
            </select>
            <span asp-validation-for="ProjectPhaseId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ParentWorkItemId" class="form-label"></label>
            <select asp-for="ParentWorkItemId" class="form-select">
                <option value="">-- Hạng mục gốc --</option>
                @foreach (var item in workItems)
                {
                    <option value="@item.Id">@item.WbsCode - @item.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="WbsCode" class="form-label"></label>
            <input asp-for="WbsCode" class="form-control" />
            <span asp-validation-for="WbsCode" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SequenceOrder" class="form-label"></label>
            <input asp-for="SequenceOrder" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<WbsItemStatus>()" class="form-select"></select>
        </div>
        <div>
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
