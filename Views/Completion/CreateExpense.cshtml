@model ConstructionProjectManagement.ViewModels.ExpenseCreateViewModel
@using ConstructionProjectManagement.Models
@{ ViewData["Title"] = "Ghi nhận chi phí"; var projects = (IReadOnlyCollection<Project>)ViewBag.Projects; }
<h1 class="h3 mb-3">Ghi nhận khoản chi</h1>
<form asp-action="CreateExpense" method="post" class="card card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Dự án</label><select asp-for="ProjectId" class="form-select"><option value="">-- Chọn --</option>@foreach(var p in projects){<option value="@p.Id">@p.ProjectCode - @p.Name</option>}</select></div><div class="col-md-6"><label asp-for="Category" class="form-label">Loại chi phí</label><input asp-for="Category" class="form-control" /></div><div class="col-md-8"><label asp-for="Description" class="form-label">Mô tả</label><input asp-for="Description" class="form-control" /></div><div class="col-md-2"><label asp-for="Amount" class="form-label">Số tiền</label><input asp-for="Amount" class="form-control" /></div><div class="col-md-2"><label asp-for="ExpenseDate" class="form-label">Ngày</label><input asp-for="ExpenseDate" class="form-control" /></div></div><button class="btn btn-primary mt-3">Lưu</button></form>
