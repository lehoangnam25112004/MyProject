@model ConstructionProjectManagement.ViewModels.CompletionIndexViewModel
@{ ViewData["Title"] = "Chi phí, hoàn thành và bàn giao"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3">Chi phí, hoàn thành và bàn giao</h1><div><a asp-action="CreateExpense" class="btn btn-outline-primary">Thêm chi phí</a> <a asp-action="CreateHandover" class="btn btn-primary">Lập bàn giao</a></div></div>
@if(TempData["SuccessMessage"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger">@error</div>}
<div class="alert alert-info">Tổng chi phí đã ghi nhận: <strong>@Model.TotalExpense.ToString("N0")</strong></div>
<h2 class="h5">Chi phí gần đây</h2><table class="table table-sm"><thead><tr><th>Dự án</th><th>Ngày</th><th>Loại</th><th>Mô tả</th><th>Số tiền</th></tr></thead><tbody>@foreach(var e in Model.Expenses){<tr><td>@e.Project.ProjectCode</td><td>@e.ExpenseDate.ToString("dd/MM/yyyy")</td><td>@e.Category</td><td>@e.Description</td><td>@e.Amount.ToString("N0")</td></tr>}</tbody></table>
<h2 class="h5 mt-4">Bàn giao</h2><table class="table table-sm"><thead><tr><th>Dự án</th><th>Tiêu đề</th><th>Người nhận</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var h in Model.Handovers){<tr><td>@h.Project.ProjectCode</td><td>@h.Title</td><td>@h.ReceivedByName</td><td>@(h.IsConfirmed ? "Đã xác nhận" : "Chờ xác nhận")</td><td>@if(!h.IsConfirmed){<form asp-action="ConfirmHandover" method="post"><input type="hidden" name="id" value="@h.Id" /><button class="btn btn-sm btn-success">Xác nhận</button></form>}@if(h.IsConfirmed){<form asp-action="Archive" method="post"><input type="hidden" name="id" value="@h.ProjectId" /><button class="btn btn-sm btn-outline-danger">Lưu trữ dự án</button></form>}</td></tr>}</tbody></table>
<h2 class="h5 mt-4">Công việc còn mở</h2><table class="table table-sm"><thead><tr><th>Dự án</th><th>Công việc</th><th>Hạn kế hoạch</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var t in Model.OpenTasks){<tr><td>@t.Project.ProjectCode</td><td>@t.Title</td><td>@t.PlannedEndDate.ToString("dd/MM/yyyy")</td><td>@t.Status</td></tr>}</tbody></table>
