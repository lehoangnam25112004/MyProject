@model ConstructionProjectManagement.ViewModels.HandoverCreateViewModel
@using ConstructionProjectManagement.Models
@{ ViewData["Title"] = "Lập hồ sơ bàn giao"; var projects = (IReadOnlyCollection<Project>)ViewBag.Projects; }
<h1 class="h3 mb-3">Lập hồ sơ bàn giao</h1>
<form asp-action="CreateHandover" method="post" class="card card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Dự án</label><select asp-for="ProjectId" class="form-select"><option value="">-- Chọn --</option>@foreach(var p in projects){<option value="@p.Id">@p.ProjectCode - @p.Name</option>}</select></div><div class="col-md-6"><label asp-for="Title" class="form-label">Tiêu đề</label><input asp-for="Title" class="form-control" /></div><div class="col-md-6"><label asp-for="ReceivedByName" class="form-label">Người tiếp nhận</label><input asp-for="ReceivedByName" class="form-control" /></div><div class="col-md-6"><label asp-for="HandoverDate" class="form-label">Ngày bàn giao</label><input asp-for="HandoverDate" class="form-control" /></div><div class="col-12"><label asp-for="Notes" class="form-label">Ghi chú</label><textarea asp-for="Notes" class="form-control"></textarea></div></div><button class="btn btn-primary mt-3">Lập hồ sơ</button></form>
