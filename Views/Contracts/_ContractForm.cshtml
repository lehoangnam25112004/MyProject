@model ConstructionProjectManagement.ViewModels.ContractEditViewModel
@using ConstructionProjectManagement.Models
@{
    var projects = (IReadOnlyCollection<Project>)ViewBag.Projects;
}

<form asp-action="@(Model.Id is null ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="ProjectId" class="form-label"></label>
                    <select asp-for="ProjectId" class="form-select">
                        <option value="">-- Chọn dự án --</option>
                        @foreach (var project in projects)
                        {
                            <option value="@project.Id">@project.ProjectCode - @project.Name</option>
                        }
                    </select>
                    <span asp-validation-for="ProjectId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContractNumber" class="form-label"></label>
                    <input asp-for="ContractNumber" class="form-control" />
                    <span asp-validation-for="ContractNumber" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ClientName" class="form-label"></label>
                    <input asp-for="ClientName" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ContractorName" class="form-label"></label>
                    <input asp-for="ContractorName" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ContractValue" class="form-label"></label>
                    <input asp-for="ContractValue" class="form-control" />
                    <span asp-validation-for="ContractValue" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="SignedDate" class="form-label"></label>
                    <input asp-for="SignedDate" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="EffectiveDate" class="form-label"></label>
                    <input asp-for="EffectiveDate" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<ContractStatus>()" class="form-select"></select>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
