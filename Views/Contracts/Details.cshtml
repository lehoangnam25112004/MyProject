@model ConstructionProjectManagement.ViewModels.ContractDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết hợp đồng";
    var contract = Model.Contract;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Hợp đồng @contract.ContractNumber</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("Project Director") || User.IsInRole("Project Manager"))
    {
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@contract.Id">Cập nhật</a>
    }
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Dự án</dt>
            <dd class="col-sm-9">@contract.Project.ProjectCode - @contract.Project.Name</dd>
            <dt class="col-sm-3">Chủ đầu tư</dt>
            <dd class="col-sm-9">@contract.ClientName</dd>
            <dt class="col-sm-3">Nhà thầu</dt>
            <dd class="col-sm-9">@contract.ContractorName</dd>
            <dt class="col-sm-3">Giá trị</dt>
            <dd class="col-sm-9">@contract.ContractValue.ToString("N0")</dd>
            <dt class="col-sm-3">Ngày ký / hiệu lực</dt>
            <dd class="col-sm-9">@contract.SignedDate?.ToString("dd/MM/yyyy") / @contract.EffectiveDate?.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">@contract.Status</dd>
        </dl>
    </div>
</div>

<h2 class="h5">Tài liệu dự án</h2>
@if (User.IsInRole("Admin") || User.IsInRole("Project Director") || User.IsInRole("Project Manager"))
{
    <form asp-action="UploadDocument" method="post" enctype="multipart/form-data" class="card card-body mb-3">
        <input type="hidden" name="contractId" value="@contract.Id" />
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="category" class="form-label">Phân loại</label>
                <input id="category" name="category" class="form-control" required />
            </div>
            <div class="col-md-5">
                <label for="file" class="form-label">Tệp (tối đa 10 MB)</label>
                <input id="file" name="file" type="file" class="form-control" required />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">Tải lên</button>
            </div>
        </div>
    </form>
}

<div class="card">
    <div class="list-group list-group-flush">
    @foreach (var document in contract.Documents)
    {
        <div class="list-group-item d-flex justify-content-between align-items-center">
            <span>@document.FileName <small class="text-muted">(@document.Category)</small></span>
            <a asp-action="DownloadDocument" asp-route-id="@document.Id">Tải xuống</a>
        </div>
    }
    </div>
</div>
